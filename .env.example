# Telegram Bot API base URL (endpoints /sendMessage and /sendPhoto are derived)
TELEGRAM_API_URL=https://api.telegram.org/bot<your_bot_token>

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID
TELEGRAM_CHAT_ID=

# Province to search for appointments
PROVINCE=Madrid

# Office (oficina) (leave empty to skip)
OFFICE=

# Procedure to search for appointments (exact dropdown text)
PROCEDURE=

# NIE
NIE=

# Full name
FULL_NAME=

# Send screenshot on appointment found (true/false)
SEND_SCREENSHOT=false

# Send notifications only when a slot is found (true/false)
SEND_NOTIFICATIONS_ONLY_ON_SUCCESS=true

# Output directory for screenshots (must be writable)
MNT_OUTPUT_DIR=/tmp/cita-extranjeria-alert
